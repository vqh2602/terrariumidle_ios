    "Trồng cây, thu thập Oxy và lắng nghe âm nhạc nhẹ nhàng ngay trên kệ gỗ." : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Grow plants, collect Oxygen, and listen to gentle music right on your wooden shelf."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "木の棚の上で植物を育て、酸素を集め、穏やかな音楽を楽しみましょう。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "원목 선반 위에서 식물을 키우고 산소를 모으며 잔잔한 음악을 감상하세요."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trồng cây, thu thập Oxy và lắng nghe âm nhạc nhẹ nhàng ngay trên kệ gỗ."
          }
