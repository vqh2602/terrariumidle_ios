        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "風になびく鯉のぼりランタンが、幸運とあふれる活気をもたらします。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "바람의 세기에 따라 흔들리는 잉어 깃발 등불로 행운과 넘치는 활력을 전해줍니다."
          }
        },
        "vi" : {
          "stringUnit" : {
