    "Trưởng thành (Lv.3)" : {
      "comment" : "A label for the level 3 of the Oxalis triangularis plant.",
      "isCommentAutoGenerated" : true
    },
    "Trạng thái" : {
      "comment" : "A label for selecting the growth state of the Plant19 plant.",
      "isCommentAutoGenerated" : true
    },
    "Trạng thái: %@" : {
      "comment" : "A label displaying the current growth state of the plant. The argument is the growth state of the plant.",
      "isCommentAutoGenerated" : true
    },
    "Trầu bà lá tim (Philodendron hederaceum) sở hữu những chiếc lá hình trái tim xanh mướt với đường gân nổi rõ, vươn lên từ những cuống mảnh duyên dáng." : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Heartleaf Philodendron (Philodendron hederaceum) features lush green heart-shaped leaves with distinct veins on slender stems."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ヒメモンステラ（フィロデンドロン）は、くっきりとした葉脈を持つみずみずしいハート型の葉が細い茎から優雅に伸びます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "하트리프 필로덴드론(Philodendron hederaceum)은 잎맥이 선명한 싱그러운 하트 모양 잎이 가느다란 줄기에서 우아하게 뻗어 나옵니다."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trầu bà lá tim (Philodendron hederaceum) sở hữu những chiếc lá hình trái tim xanh mướt với đường gân nổi rõ, vươn lên từ những cuống mảnh duyên dáng."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "心叶蔓绿绒（Philodendron hederaceum）拥有叶脉清晰的翠绿心形叶片，优雅地伸展在纤细茎蔓上。"
          }
        }
      }
    },
    "Trầu bà lá xẻ (Monstera Deliciosa) nổi bật với những phiến lá to bản xẻ thùy độc đáo, mang đậm hơi thở rừng nhiệt đới." : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Monstera Deliciosa stands out with large, uniquely fenestrated leaves full of tropical charm."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "モンステラ・デリシオーサは大きく切れ込みの入ったユニークな葉が特徴で、南国の森の息吹を感じさせます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "몬스테라(Monstera Deliciosa)는 큼직하고 독특하게 갈라진 잎이 돋보이며 열대 우림의 분위기를 가득 담고 있습니다."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trầu bà lá xẻ (Monstera Deliciosa) nổi bật với những phiến lá to bản xẻ thùy độc đáo, mang đậm hơi thở rừng nhiệt đới."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "龟背竹（Monstera Deliciosa）以宽大独特的裂叶著称，洋溢浓郁热带雨林气息。"
          }
        }
      }
    },
    "Trầu bà lá xẻ mini (Rhaphidophora tetrasperma) nổi bật với những phiến lá xẻ thùy sâu độc đáo, mang nét đẹp nhiệt đới gọn gàng." : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mini Monstera (Rhaphidophora tetrasperma) features deeply lobed leaves with neat tropical beauty."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ヒメモンステラは深い切れ込みのある葉が美しく、コンパクトな南国の趣があります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "히메 몬스테라(Rhaphidophora tetrasperma)는 깊게 갈라진 잎이 돋보이며 아담하고 세련된 열대미를 자랑합니다."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trầu bà lá xẻ mini (Rhaphidophora tetrasperma) nổi bật với những phiến lá xẻ thùy sâu độc đáo, mang nét đẹp nhiệt đới gọn gàng."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "姬龟背竹（Rhaphidophora tetrasperma）拥有深裂叶片，展现精致小巧的热带美感。"
          }
        }
      }
    },
    "Trầu bà tim xanh (Heartleaf philodendron) nổi bật với những phiến lá trái tim mềm mại, xanh tươi mơn mởn trên các nhánh thân mảnh." : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Heartleaf Philodendron shines with soft, vibrant green heart-shaped leaves along delicate vines."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ハートリーフ・フィロデンドロンは、細い茎に茂る柔らかで鮮やかな緑のハート葉が魅力です。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "하트리프 필로덴드론(Heartleaf philodendron)은 가는 줄기마다 부드럽고 싱그러운 초록빛 하트 잎이 돋보입니다."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trầu bà tim xanh (Heartleaf philodendron) nổi bật với những phiến lá trái tim mềm mại, xanh tươi mơn mởn trên các nhánh thân mảnh."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "绿心蔓绿绒（Heartleaf philodendron）在纤细枝蔓上长满柔软鲜嫩的翠绿心形叶片。"
          }
        }
      }
    },
