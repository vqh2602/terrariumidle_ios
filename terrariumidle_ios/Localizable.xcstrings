    "%d ngày đạt mục tiêu trong kỳ. Mỗi chiếc lá là một ngày bạn dành thời gian cho mình." : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%d days met your goal this period. Each leaf is a day you took time for yourself."
