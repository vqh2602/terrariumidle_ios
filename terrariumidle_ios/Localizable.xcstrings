    },
    "Nhận bù trong 7 ngày kể từ ngày hoàn thành mốc. Một ngày chỉ tính cho một mốc tuần; mốc tháng vẫn được cộng thêm." : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Claimable within 7 days of completing a milestone. Each day counts toward one weekly milestone; monthly milestones still stack."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "達成日から7日以内に受け取れます。1日は1つの週間マイルストーンにのみカウントされ、月間報酬は別途加算されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "달성일로부터 7일 이내에 받을 수 있습니다. 하루는 하나의 주간 마일스톤에만 포함되며 월간 보상은 추가로 누적됩니다."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nhận bù trong 7 ngày kể từ ngày hoàn thành mốc. Một ngày chỉ tính cho một mốc tuần; mốc tháng vẫn được cộng thêm."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "达成后7天内可补领。每天仅计入一个周里程碑；月里程碑仍可叠加。"
          }
        }
      }
    },
