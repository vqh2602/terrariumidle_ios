    "Dây chuỗi tim (Ceropegia woodii) với những dây leo mềm rủ xuống duyên dáng, kết nối hàng loạt chiếc lá hình trái tim xanh biếc xinh xắn." : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "String of Hearts (Ceropegia woodii) trails graceful vines adorned with dainty heart-shaped green leaves."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ハートカズラは可愛らしいハート型の葉が連なる優雅なツルを垂らします。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "러브체인(Ceropegia woodii)은 앙증맞은 하트 모양 초록 잎이 줄줄이 달린 덩굴이 우아하게 늘어집니다."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dây chuỗi tim (Ceropegia woodii) với những dây leo mềm rủ xuống duyên dáng, kết nối hàng loạt chiếc lá hình trái tim xanh biếc xinh xắn."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "爱之蔓（Ceropegia woodii）垂落纤柔蔓枝，串起一串串可爱的翠绿心形叶片。"
          }
        }
      }
    },
    "Dùng Oxy mở thêm tầng kệ mới và mua cây, chậu tại Cửa hàng." : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Use Oxygen to unlock new shelf tiers and buy plants and pots in the Store."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "酸素を使って新しい棚を解放し、ストアで植物や鉢を購入しましょう。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "산소를 사용해 새 선반 층을 열고 상점에서 식물과 화분을 구매하세요."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dùng Oxy mở thêm tầng kệ mới và mua cây, chậu tại Cửa hàng."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "使用氧气解锁新花架层，并在商店购买植物和花盆。"
          }
        }
      }
    },
    "Dùng Vé tạo mưa gió tự tap toàn vườn trong 60s và ghé thăm vườn bạn bè." : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Use Tickets to summon rain or wind for 60s garden auto-tap, and visit friends' gardens."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
