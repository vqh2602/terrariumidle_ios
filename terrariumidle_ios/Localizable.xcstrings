    "Chú mèo thần tài Maneki-neko vẫy tay chào đón may mắn, gọi tài lộc và bình an về khu vườn." : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A lucky Maneki-neko cat waving to invite fortune, prosperity, and peace to your garden."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "手招きして幸運と繁栄、穏やかさをガーデンに呼び込む招き猫。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "행운과 재물, 평안을 정원으로 불러들이며 손을 흔드는 마네키네코 고양이."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chú mèo thần tài Maneki-neko vẫy tay chào đón may mắn, gọi tài lộc và bình an về khu vườn."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "招财猫挥手迎福，为花园带来财运与平安。"
          }
        }
      }
    },
