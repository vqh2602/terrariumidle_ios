    },
    "Ánh hoàng hôn dịu nhẹ, mây chiều trôi êm ả" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Soft sunset glow with drifting evening clouds"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "穏やかな夕焼けと静かに流れる夕雲"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "은은한 노을빛과 고요히 흐르는 저녁 구름"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ánh hoàng hôn dịu nhẹ, mây chiều trôi êm ả"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "柔和落日余晖，晚云轻柔飘过"
          }
        }
      }
    },
    "Ánh mặt trời rực rỡ lấp ló sau những tầng núi trùng điệp trong ánh nắng vàng ấm." : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Radiant sunlight peeking behind layered mountain peaks in warm golden rays."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "幾重にも重なる山々の向こうから覗く、温かな黄金色の太陽の光。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "겹겹이 쌓인 산봉우리 너머로 따스한 황금빛 햇살을 비추는 찬란한 태양."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ánh mặt trời rực rỡ lấp ló sau những tầng núi trùng điệp trong ánh nắng vàng ấm."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "耀眼的阳光从层峦叠嶂后探出，洒下温暖金辉。"
          }
        }
      }
    },
