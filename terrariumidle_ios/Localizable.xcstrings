    },
    "Khi sẵn sàng, hãy ghi lại giấc ngủ đêm qua." : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "When ready, log last night's sleep."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "準備ができたら、昨夜の睡眠を記録しましょう。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "준비가 되면 어젯밤 수면을 기록해 보세요."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Khi sẵn sàng, hãy ghi lại giấc ngủ đêm qua."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "准备好后，记录昨晚的睡眠吧。"
          }
        }
      }
    },
    "Khi thêm bản ghi mới, bạn vẫn có thể chọn chỉ lưu trên thiết bị. Các khoảng ngủ trùng nhau chỉ được tính một lần trong biểu đồ." : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "When adding a new entry, you can still choose device-only storage. Overlapping sleep intervals are counted only once in charts."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "新しい記録を追加する際もデバイス内のみに保存できます。重複する睡眠時間はグラフで1回のみカウントされます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "새 기록을 추가할 때도 기기 전용 저장을 선택할 수 있습니다. 겹치는 수면 구간은 차트에서 한 번만 계산됩니다."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Khi thêm bản ghi mới, bạn vẫn có thể chọn chỉ lưu trên thiết bị. Các khoảng ngủ trùng nhau chỉ được tính một lần trong biểu đồ."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "添加新记录时仍可选择仅保存在设备上。重叠的睡眠时段在图表中仅计算一次。"
          }
        }
      }
    },
