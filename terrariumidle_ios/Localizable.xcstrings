    "Xương rồng tai thỏ (Prickly Pear Cactus) với những bẹ lá xanh mướt điểm chấm vàng rực rỡ, mang vẻ đẹp hoang mạc đáng yêu." : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prickly Pear Cactus has lush green pads dotted with bright yellow spines, bringing adorable desert charm."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ウチワサボテンは明るい黄色の斑点が映えるみずみずしい緑の茎節を持ち、愛らしい砂漠の魅力を放ちます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "백년초 선인장(Prickly Pear Cactus)은 싱그러운 초록 잎판에 선명한 노란 점이 어우러져 사랑스러운 사막의 매력을 줍니다."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Xương rồng tai thỏ (Prickly Pear Cactus) với những bẹ lá xanh mướt điểm chấm vàng rực rỡ, mang vẻ đẹp hoang mạc đáng yêu."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "仙人掌（Prickly Pear Cactus）翠绿扁平的茎片点缀亮黄绒刺，散发可爱的沙漠风情。"
          }
        }
      }
    },
