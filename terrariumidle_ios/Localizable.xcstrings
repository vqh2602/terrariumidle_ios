    "Đạt mục tiêu Giấc ngủ và Bước chân mỗi ngày để nhận Oxy, Đá quý và Vé thời tiết." : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reach your daily Sleep and Steps goals to earn Oxygen, Gems, and Weather Tickets."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "毎日の睡眠と歩数の目標を達成して、酸素・ジェム・天気チケットを手に入れましょう。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "매일 수면과 걸음 수 목표를 달성해 산소, 보석, 날씨 티켓을 받으세요."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Đạt mục tiêu Giấc ngủ và Bước chân mỗi ngày để nhận Oxy, Đá quý và Vé thời tiết."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "每日达成睡眠与步数目标，即可获得氧气、宝石和天气券。"
          }
        }
      }
    },
