    "Hoa oải hương (Lavender) với những nhành hoa tím biếc thơm ngát vươn cao trên nền lá xanh bạc dịu dàng." : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lavender rises with fragrant deep-purple blooms above soft silvery-green foliage."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ラベンダーは柔らかな銀緑の葉の上に、香り高い深い紫の花穂を伸ばします。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "라벤더(Lavender)는 은은한 은빛 초록 잎 위로 향기로운 짙은 보라색 꽃대가 솟아오릅니다."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hoa oải hương (Lavender) với những nhành hoa tím biếc thơm ngát vươn cao trên nền lá xanh bạc dịu dàng."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "薰衣草（Lavender）在柔和的银绿色叶片衬托下，绽放出芬芳浓郁的紫色花穗。"
          }
        }
      }
