    "Búp bê cầu nắng treo đung đưa theo gió, mang lại ngày nắng đẹp trời." : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A hanging teru teru bozu swaying in the breeze, bringing bright sunny days."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "風に揺れるてるてる坊主。晴れた心地よい日をもたらします。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "바람에 살랑이는 테루테루보즈 인형으로 맑고 화창한 날을 불러옵니다."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Búp bê cầu nắng treo đung đưa theo gió, mang lại ngày nắng đẹp trời."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "随风摇曳的晴天娃娃，带来明媚晴朗的好天气。"
