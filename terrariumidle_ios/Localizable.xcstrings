    "Thu hải đường lá cảnh (Begonia Rex) nổi bật với tán lá viền răng cưa mang họa tiết xanh thẫm, hồng và đỏ tía rực rỡ." : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Begonia Rex stands out with serrated leaves patterned in deep green, pink, and vibrant crimson."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "レックスベゴニアは深緑・ピンク・赤紫の鮮やかな模様が入った鋸歯状の葉が際立ちます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "베고니아 렉스(Begonia Rex)는 짙은 초록, 분홍, 자주빛 화려한 무늬가 돋보이는 톱니 모양 잎이 매력적입니다."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Thu hải đường lá cảnh (Begonia Rex) nổi bật với tán lá viền răng cưa mang họa tiết xanh thẫm, hồng và đỏ tía rực rỡ."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "彩叶秋海棠（Begonia Rex）以锯齿状叶缘和深绿、粉红与紫红交织的绚丽斑纹著称。"
          }
        }
      }
    },
