    "Bình gốm cổ thon cao màu hồng san hô dịu dàng 🪸" : {
      "comment" : "Tên của Chậu 29: \"Bình gốm san hô cổ cao\" (pot29).",
      "isCommentAutoGenerated" : true
    },
    "Bình gốm cổ thon cao màu hồng san hô dịu dàng, tạo điểm nhấn nghệ thuật độc đáo." : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A tall slender ceramic vase in soft coral pink, adding an artistic touch."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "柔らかなコーラルピンクの細長い陶器の花瓶。芸術的なアクセントになります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "부드러운 코랄 핑크빛의 길쭉한 도자기 화병으로, 독특한 예술적 포인트를 더해줍니다."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bình gốm cổ thon cao màu hồng san hô dịu dàng, tạo điểm nhấn nghệ thuật độc đáo."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "柔和珊瑚粉的高挑细颈陶瓷花瓶，打造独特艺术美感。"
          }
        }
      }
    },
    "Bình gốm san hô cổ cao" : {
      "extractionState" : "manual",
