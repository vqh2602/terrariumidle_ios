    "Lặp lại hằng ngày theo giờ trên thiết bị. Bạn có thể tắt riêng từng lời nhắc." : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Repeats daily at your device's local time. You can toggle each reminder separately."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "デバイスの時刻に合わせて毎日繰り返します。各リマインダーは個別にオフにできます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "기기 시간에 맞춰 매일 반복됩니다. 각 알림은 개별적으로 끌 수 있습니다."
