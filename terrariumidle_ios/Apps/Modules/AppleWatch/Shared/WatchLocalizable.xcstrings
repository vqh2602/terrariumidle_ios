    },
    "Bật quyền vị trí trong Cài đặt để xem thời tiết.": {
      "extractionState": "manual",
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bật quyền vị trí trong Cài đặt để xem thời tiết."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Enable location access in Settings to see weather."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "天気を表示するには設定で位置情報へのアクセスを許可してください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
