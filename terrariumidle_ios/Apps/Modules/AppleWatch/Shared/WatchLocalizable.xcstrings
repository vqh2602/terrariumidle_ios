    },
    "Chưa lấy được thời tiết. Hãy kiểm tra mạng, quyền vị trí và cấu hình WeatherKit.": {
      "extractionState": "manual",
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chưa lấy được thời tiết. Hãy kiểm tra mạng, quyền vị trí và cấu hình WeatherKit."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Could not load weather. Check your network, location permission, and WeatherKit setup."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "天気を取得できません。ネットワーク、位置情報の許可、WeatherKitの設定を確認してください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法获取天气，请检查网络、位置权限和 WeatherKit 配置。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "날씨를 불러오지 못했습니다. 네트워크, 위치 권한 및 WeatherKit 설정을 확인하세요."
          }
        }
      }
    },
    "Thời tiết được cập nhật khi mở app iPhone; widget không cập nhật liên tục.": {
      "extractionState": "manual",
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Thời tiết được cập nhật khi mở app iPhone; widget không cập nhật liên tục."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Weather refreshes when you open the iPhone app. Widgets do not update continuously."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "天気はiPhoneアプリを開いたときに更新されます。ウィジェットは常時更新されません。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "打开 iPhone 应用时会刷新天气，小组件不会持续更新。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhone 앱을 열면 날씨가 새로고침됩니다. 위젯은 계속 업데이트되지 않습니다."
          }
        }
      }
    },
    "Vị trí chỉ dùng trên iPhone để lấy thời tiết. Watch nhận số liệu, không nhận tọa độ. Có thể chọn độ C hoặc độ F trong cấu hình widget.": {
      "extractionState": "manual",
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Vị trí chỉ dùng trên iPhone để lấy thời tiết. Watch nhận số liệu, không nhận tọa độ. Có thể chọn độ C hoặc độ F trong cấu hình widget."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhone uses your location to request weather. Watch receives readings, not coordinates. Choose Celsius or Fahrenheit in each widget configuration."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhoneが位置情報を使って天気を取得します。Watchには数値のみが送信され、座標は送信されません。ウィジェットごとに摂氏か華氏を選べます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhone 使用位置来请求天气，Watch 仅接收数据，不接收坐标。可在每个小组件的配置中选择摄氏或华氏。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhone이 위치를 사용해 날씨를 요청합니다. Watch에는 좌표 없이 수치만 전달됩니다. 위젯 구성에서 섭씨 또는 화씨를 선택하세요."
          }
        }
      }
    },
