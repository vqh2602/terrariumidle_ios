    "Chưa gửi được; sẽ thử lại khi kết nối trở lại": {
      "extractionState": "manual",
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chưa gửi được; sẽ thử lại khi kết nối trở lại"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Could not send. Will retry when connected."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "送信できませんでした。接続後に再試行します。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "发送失败，连接恢复后将重试。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "전송하지 못했습니다. 연결되면 다시 시도합니다."
          }
        }
      }
    },
