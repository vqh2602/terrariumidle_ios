        }
      }
    },
    "Bật kết nối trong Terrarium trên iPhone. Cây vẫn phát triển bình thường khi không có dữ liệu.": {
      "extractionState": "manual",
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bật kết nối trong Terrarium trên iPhone. Cây vẫn phát triển bình thường khi không có dữ liệu."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Enable the connection in Terrarium on iPhone. Your plant keeps growing normally without sleep data."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhoneのTerrariumで接続を有効にしてください。睡眠データがなくても植物は通常どおり成長します。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请在 iPhone 的 Terrarium 中启用连接。没有睡眠数据时，植物仍会正常生长。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhone의 Terrarium에서 연결을 켜세요. 수면 데이터가 없어도 식물은 평소처럼 자랍니다."
          }
        }
      }
    },
    "Bật lịch trên iPhone": {
