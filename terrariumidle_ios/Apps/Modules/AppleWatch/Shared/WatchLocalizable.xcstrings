    },
    "Chưa có dữ liệu ngủ được chia sẻ. Cây vẫn phát triển bình thường.": {
      "extractionState": "manual",
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chưa có dữ liệu ngủ được chia sẻ. Cây vẫn phát triển bình thường."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No shared sleep data yet. Your plant keeps growing normally."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "共有された睡眠データはありません。植物は通常どおり成長します。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "暂无共享的睡眠数据。植物仍会正常生长。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "공유된 수면 데이터가 없습니다. 식물은 평소처럼 자랍니다."
          }
        }
      }
    },
