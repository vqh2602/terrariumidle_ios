    "Giây và chuyển động tự tắt khi màn hình giảm sáng hoặc bật Giảm chuyển động.": {
      "extractionState": "manual",
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Giây và chuyển động tự tắt khi màn hình giảm sáng hoặc bật Giảm chuyển động."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Seconds and motion are hidden when the display dims or Reduce Motion is enabled."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "画面が暗くなるか「視差効果を減らす」が有効になると、秒表示と動きは停止します。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "屏幕变暗或开启“减弱动态效果”时，秒数和动画会自动关闭。"
